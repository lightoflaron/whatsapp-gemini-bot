# Dapatkan gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Akun Instagram kamu
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Topik/niche konten yang diposting (ubah sesuai kebutuhan)
NICHE=motivasi harian

# Waktu posting otomatis (format 24 jam)
POST_TIME=09:00

# Telegram Bot (wajib diisi)
# Cara dapat token: chat @BotFather di Telegram → /newbot
# Cara dapat chat_id kamu: chat @userinfobot di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ID Channel Telegram tempat konten diposting
# Format: -100xxxxxxxxxx (dengan tanda minus di depan)
# Cara dapat: forward pesan dari channel ke @userinfobot
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
